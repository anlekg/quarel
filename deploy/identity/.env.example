# Optional: every setting below can also be changed in the administration page
# (http://localhost:8081 through an SSH tunnel). A variable set here wins over
# the page, which then shows the setting as locked.

# Public name of the service. It is part of every identity (pseudo@QUAREL_ISSUER)
# and of the servers' configuration: choose it once, never change it.
QUAREL_ISSUER=identity.example.org

# Let's Encrypt (compose.yaml only).
QUAREL_TLS_DOMAIN=identity.example.org
QUAREL_TLS_EMAIL=admin@example.org

# Emails (verification codes, password resets). Without SMTP, codes are only
# written to the service log: fine for a test, not for real users.
QUAREL_SMTP_HOST=smtp.example.org
QUAREL_SMTP_PORT=587
QUAREL_SMTP_USER=quarel@example.org
QUAREL_SMTP_PASSWORD=change-me
QUAREL_SMTP_FROM=Quarel <quarel@example.org>

# Who may create an account: open, invite (invitation code, created in the
# administration page) or closed. identity.quarel.app starts by invitation.
QUAREL_REGISTRATION=invite
# QUAREL_REGISTRATION_DOMAINS=asso.fr   # only these email domains
# QUAREL_MAX_ACCOUNTS=0                 # 0: no cap
# QUAREL_USER_INVITES=0                 # invitations each user may create

# Community servers: open (all, except blocked ones) or approved (approved only).
QUAREL_SERVER_POLICY=open

# Lifetime of identity tokens given to community servers.
QUAREL_TOKEN_TTL=12h

# Relay for calls between friends when no direct path exists (media stays
# end-to-end encrypted). Needs UDP ports 3478 and 49160-49200 open to this
# machine. Public IP: "auto" (found by STUN, followed if it changes) or the
# address itself. In this Docker setup (bridge network), UPnP cannot open the
# router's ports: open them yourself, or use network_mode: host.
QUAREL_TURN=on
QUAREL_TURN_PUBLIC_IP=auto
QUAREL_TURN_PORTS=49160-49200
