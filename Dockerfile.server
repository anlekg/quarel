# Quarel community server (+ embedded LiveKit for voice)
# Build : docker build -f Dockerfile.server -t quarel-server .
FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/anlekg/quarel/internal/backup.Release=${VERSION}" -o /out/quarel-server ./cmd/quarel-server \
 && mkdir -p /out/data

# Official LiveKit SFU binary (statically linked), pinned.
FROM livekit/livekit-server:v1.13.7@sha256:6fd3b7088874c4d119160dd688798dfec852bc014786d392caad15f6f63912a3 AS livekit

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/quarel-server /quarel-server
COPY --from=livekit /livekit-server /livekit-server
COPY --from=build --chown=65532:65532 /out/data /data
ENV QUAREL_ADDR=:8090 QUAREL_DATA_DIR=/data QUAREL_LIVEKIT_BIN=/livekit-server
VOLUME /data
# 8090/tcp: API, real-time gateway, voice signalling (/lk). 7881/tcp + 7882/udp: voice media.
# 8091/tcp: administration page (local network only, password; never opened on the router).
EXPOSE 8090 8091 7881 7882/udp
ENTRYPOINT ["/quarel-server"]
