# Quarel community server
# Build : docker build -f Dockerfile.server -t quarel-server .
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/quarel-server ./cmd/quarel-server \
 && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/quarel-server /quarel-server
COPY --from=build --chown=65532:65532 /out/data /data
ENV QUAREL_ADDR=:8090 QUAREL_DATA_DIR=/data
VOLUME /data
EXPOSE 8090
ENTRYPOINT ["/quarel-server"]
