# Quarel Identity service
# Build : docker build -f Dockerfile.identity -t quarel-identity .
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/quarel-identity ./cmd/quarel-identity \
 && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/quarel-identity /quarel-identity
COPY --from=build --chown=65532:65532 /out/data /data
ENV QUAREL_ADDR=:8080 QUAREL_DATA_DIR=/data
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/quarel-identity"]
